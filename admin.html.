
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stephenie Nova Admin</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}
body{margin:0;background:#fff4f8;color:#54263b;font-family:Arial,sans-serif;padding:18px}
header{background:#f6bfd7;padding:22px;border-radius:18px;text-align:center;margin-bottom:20px}
h1{margin:0;font-size:25px}
h2{font-size:20px}
.panel{background:white;padding:18px;border-radius:16px;margin:15px 0;box-shadow:0 3px 14px #e8bfd0}
input,button{width:100%;padding:13px;margin:7px 0;border-radius:10px;border:1px solid #e4b5c9;font-size:15px}
input[type=checkbox]{width:auto}
button{background:#d94d8b;color:white;border:0;font-weight:bold}
button.secondary{background:#80506a}
button.delete{background:#b52d52}
small{color:#87566d}
.product{border-top:1px solid #f0d7e2;padding:13px 0;display:flex;gap:12px;align-items:center}
.product img{width:75px;height:75px;object-fit:cover;border-radius:10px;background:#f8e8ef}
.product div{flex:1;min-width:0}
.product button{padding:9px;margin:4px 0}
#dashboard{display:none}
#status{padding:10px;font-size:14px;white-space:pre-wrap}
</style>
</head>
<body>

<header>
<h1>STEPHENIE NOVA</h1>
<p>Admin Dashboard ✨</p>
</header>

<section class="panel" id="login">
<h2>Admin Login</h2>
<input id="email" type="email" placeholder="Admin email">
<input id="password" type="password" placeholder="Password">
<button onclick="loginAdmin()">Log In</button>
<div id="loginStatus"></div>
</section>

<main id="dashboard">
<div class="panel">
<h2>Products</h2>
<button onclick="loadProducts()">Refresh products</button>
<button class="secondary" onclick="logout()">Log out</button>
<div id="products"></div>
</div>

<div class="panel">
<h2 id="formTitle">Add New Product</h2>
<input id="name" placeholder="Product name">
<input id="price" type="number" placeholder="Selling price (₦)">
<input id="oldPrice" type="number" placeholder="Old price (optional)">
<label><input id="available" type="checkbox" checked> Product available</label>
<p><b>Product photos</b></p>
<input id="photos" type="file" accept="image/*" multiple>
<small>You can select more than one photo.</small>
<div id="photoPreview"></div>
<button onclick="saveProduct()">Save Product</button>
<button class="secondary" onclick="resetForm()">Clear form</button>
<div id="status"></div>
</div>
</main>

<script>
const SUPABASE_URL = "https://cnkggilywausfgoacgva.supabase.co";
const SUPABASE_KEY = "sb_publishable_znAq3vcHAmCeFh7JlujzvQ_YJjMByRU";
const ADMIN_UID = "9737ea64-5492-4b47-ac12-1013120263fb";

const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

let editingId = null;
let existingImages = [];

function message(text){
  document.getElementById("status").textContent = text;
}

async function checkSession(){
  const {data,error} = await db.auth.getSession();
  if(error) return;
  if(data.session) await showDashboard(data.session.user);
}

async function loginAdmin(){
  const email = document.getElementById("email").value.trim();
  const password = document.getElementById("password").value;
  const output = document.getElementById("loginStatus");
  output.textContent = "Logging in...";

  const {data,error} = await db.auth.signInWithPassword({email,password});

  if(error){
    output.textContent = error.message;
    return;
  }

  await showDashboard(data.user);
}

async function showDashboard(user){
  if(!user || user.id !== ADMIN_UID){
    await db.auth.signOut();
    document.getElementById("loginStatus").textContent =
      "This account is not authorised as the shop admin.";
    return;
  }

  document.getElementById("login").style.display = "none";
  document.getElementById("dashboard").style.display = "block";
  await loadProducts();
}

async function logout(){
  await db.auth.signOut();
  location.reload();
}

async function loadProducts(){
  const area = document.getElementById("products");
  area.textContent = "Loading products...";

  const {data,error} = await db
    .from("products")
    .select("*")
    .order("created_at",{ascending:false});

  if(error){
    area.textContent = "Could not load products: " + error.message;
    return;
  }

  if(!data.length){
    area.textContent = "No products yet. Add your first product below.";
    return;
  }

  area.innerHTML = "";

  data.forEach(product=>{
    const item = document.createElement("div");
    item.className = "product";

    const img = document.createElement("img");
    img.src = product.image_url || "";
    img.alt = product.name;

    const details = document.createElement("div");
    const title = document.createElement("b");
    title.textContent = product.name;

    const price = document.createElement("p");
    price.textContent = "₦" + Number(product.price).toLocaleString();

    const state = document.createElement("small");
    state.textContent = product.available ? "Available" : "Unavailable";

    const edit = document.createElement("button");
    edit.textContent = "Edit";
    edit.onclick = ()=>editProduct(product);

    const remove = document.createElement("button");
    remove.textContent = "Delete";
    remove.className = "delete";
    remove.onclick = ()=>deleteProduct(product.id);

    details.append(title,price,state,edit,remove);
    item.append(img,details);
    area.append(item);
  });
}

function editProduct(product){
  editingId = product.id;
  existingImages = Array.isArray(product.images) ? product.images : [];

  document.getElementById("formTitle").textContent = "Edit Product";
  document.getElementById("name").value = product.name || "";
  document.getElementById("price").value = product.price || "";
  document.getElementById("oldPrice").value = product.old_price || "";
  document.getElementById("available").checked = !!product.available;
  document.getElementById("photos").value = "";
  document.getElementById("photoPreview").textContent =
    existingImages.length + " existing photo(s) will be kept unless you add more.";
  message("Editing " + product.name);
  window.scrollTo({top:document.body.scrollHeight,behavior:"smooth"});
}

function resetForm(){
  editingId = null;
  existingImages = [];
  document.getElementById("formTitle").textContent = "Add New Product";
  document.getElementById("name").value = "";
  document.getElementById("price").value = "";
  document.getElementById("oldPrice").value = "";
  document.getElementById("available").checked = true;
  document.getElementById("photos").value = "";
  document.getElementById("photoPreview").textContent = "";
  message("");
}

async function saveProduct(){
  const name = document.getElementById("name").value.trim();
  const price = Number(document.getElementById("price").value);
  const oldPriceValue = document.getElementById("oldPrice").value;
  const old_price = oldPriceValue ? Number(oldPriceValue) : null;
  const available = document.getElementById("available").checked;
  const files = [...document.getElementById("photos").files];

  if(!name || !price || price <= 0){
    message("Enter a product name and a valid price.");
    return;
  }

  message("Saving product...");

  const {data:userData,error:userError} = await db.auth.getUser();
  if(userError || !userData.user || userData.user.id !== ADMIN_UID){
    message("Please log in with the authorised admin account.");
    return;
  }

  let imageUrls = [...existingImages];

  for(const file of files){
    const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g,"_");
    const path = ADMIN_UID + "/" + Date.now() + "_" + safeName;

    const {error:uploadError} = await db.storage
      .from("product-images")
      .upload(path,file,{upsert:false});

    if(uploadError){
      message("Photo upload failed: " + uploadError.message);
      return;
    }

    const {data:urlData} = db.storage
      .from("product-images")
      .getPublicUrl(path);

    imageUrls.push(urlData.publicUrl);
  }

  const product = {
    name,
    price,
    old_price,
    image_url: imageUrls[0] || null,
    images: imageUrls,
    available
  };

  let result;

  if(editingId){
    result = await db.from("products").update(product).eq("id",editingId);
  }else{
    result = await db.from("products").insert(product);
  }

  if(result.error){
    message("Could not save: " + result.error.message);
    return;
  }

  message("Product saved successfully!");
  resetForm();
  await loadProducts();
}

async function deleteProduct(id){
  if(!confirm("Delete this product?")) return;

  const {error} = await db.from("products").delete().eq("id",id);

  if(error){
    message("Delete failed: " + error.message);
    return;
  }

  message("Product deleted.");
  await loadProducts();
}

document.getElementById("photos").addEventListener("change",event=>{
  const files = [...event.target.files];
  document.getElementById("photoPreview").textContent =
    files.length + " new photo(s) selected.";
});

checkSession();
</script>
</body>
</html>
